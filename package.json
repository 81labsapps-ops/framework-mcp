{
  "name": "framework-mcp",
  "version": "0.3.0",
  "description": "A dependency currency-check layer for coding agents: verified, version-pinned answers about fast-moving frameworks over remote MCP.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "create-api-key": "tsx --env-file=.env scripts/create-api-key.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
