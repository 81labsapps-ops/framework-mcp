# Postgres connection string (Neon: get from your project's dashboard).
# Use a "dev" branch connection string for local development.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. Used to HMAC-hash API keys before storing them -
# never store raw keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=

# Only needed in production deploys.
PORT=3000
NODE_ENV=development
PUBLIC_HOSTNAME=
